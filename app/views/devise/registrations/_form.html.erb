<%= f.error_notification %>
<div class="form-inputs">
  <%= f.input :nickname,
                required: true,
                autofocus: true,
                input_html: { class: "form-control" } %>
  <%= f.input :email,
              required: true,
              autofocus: !f.object.new_record?,
              input_html: { autocomplete: "email", class: "form-control" } %>
  <% if devise_mapping.confirmable? && f.object.respond_to?(:pending_reconfirmation?) && f.object.pending_reconfirmation? %>
    <div class="alert alert-info small">
      Currently waiting confirmation for: <%= f.object.unconfirmed_email %>
    </div>
  <% end %>
  <%= f.input :birth_date,
            as: :date,
            discard_day: true,
            start_year: Date.current.year - 120,
            end_year: Date.current.year - 18,
            default: Date.new(2005, 1, 1) %>
  <%= f.input :start_smoking_year,
            as: :select,
            collection: (Date.current.year - 120..Date.current.year).to_a.reverse,
            prompt: "Select year",
            input_html: { class: "form-select" } %>
  <%= f.input :password,
              required: f.object.new_record?,
              hint: (f.object.new_record? ? ("#{@minimum_password_length} characters minimum" if @minimum_password_length) : "leave it blank if you don't want to change it"),
              input_html: { autocomplete: f.object.new_record? ? "new-password" : "new-password", class: "form-control" } %>
  <%= f.input :password_confirmation,
              required: f.object.new_record?,
              input_html: { autocomplete: "new-password", class: "form-control" } %>
  <% unless f.object.new_record? %>
    <%= f.input :current_password,
                hint: "we need your current password to confirm your changes",
                required: true,
                input_html: { autocomplete: "current-password", class: "form-control" } %>
  <% end %>
</div>
