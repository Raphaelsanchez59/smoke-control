<%# app/views/messages/_message.html.erb %>
<% if message.role == "user" %>
  <div class="d-flex justify-content-end mb-3" id="<%= dom_id(message) %>">
    <div class="bubble bubble-user"><%= message.content %></div>
  </div>
<% else %>
  <div class="d-flex justify-content-start mb-3" id="<%= dom_id(message) %>">
    <div class="bubble bubble-bot" data-controller="<%= 'typewriter' if message.created_at > 15.seconds.ago && message == message.chat.messages.last %>">
      <%= message.content.present? ? sanitize(Kramdown::Document.new(message.content, input: "GFM").to_html) : "..." %>
    </div>
  </div>
<% end %>
