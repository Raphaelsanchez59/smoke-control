<% if user_signed_in? %>
  <section class="card border-0 shadow-sm rounded-4 bg-transparent">
    <div class="card-body p-4 p-lg-5">
      <div class="text-center mb-4">
        <h2 class="h2 fw-bold mb-1">Smoker Profiles</h2>
        <p class="text-muted mb-0">Compare your life expectancy</p>
      </div>
      <% if @smoker_profiles.any? %>
        <div class="row row-cols-1 row-cols-md-3 g-4">
          <% @smoker_profiles.each do |profile| %>
            <%= render "smoker_profiles/card",
                       profile_data: profile.chat&.profile_data,
                       smoker_profil: profile %>
          <% end %>
        </div>
        <div class="modal fade" id="deleteProfileModal" tabindex="-1" aria-hidden="true">
          <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border rounded-4 shadow p-3">
              <p class="mb-3 fw-semibold">Delete this profile?</p>
              <div class="d-flex justify-content-end gap-2">
                <button type="button" class="btn border text-body" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteProfileForm" method="post">
                  <input type="hidden" name="_method" value="delete">
                  <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
                  <button type="submit" class="btn btn-danger">Delete</button>
                </form>
              </div>
            </div>
          </div>
        <% else %>
          <div class="border rounded-3 bg-light text-center py-5 px-4 my-2">
            <div class="mx-auto" style="max-width: 26rem;">
              <h3 class="h6 fw-semibold mb-1">No smoker profile yet</h3>
              <p class="text-body-secondary small mb-0">
                Create a smoker profile to find out how much time you have left to live.
              </p>
            </div>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>
