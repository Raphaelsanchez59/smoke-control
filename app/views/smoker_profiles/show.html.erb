<div class="container py-5">
  <div class="card shadow-sm border-0 rounded-4 overflow-hidden mx-auto" style="max-width: 900px;">
    <div class="row g-0 align-items-center">
      <!-- Image à gauche -->
      <div class="col-md-4 bg-light p-4 text-center">
      <%= image_tag @smoker_profile.photo_asset,
                    alt: @smoker_profile.name,
                    class: "img-fluid rounded-3",
                    style: "max-height: 260px; object-fit: contain;" %>
    </div>

      <!-- Profil en paragraphe à côté -->
      <div class="col-md-8 p-4 p-md-5">
        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
          <h1 class="h3 mb-0"><%= @smoker_profile.name %></h1>
          <% if @smoker_profile.cigarette_type.present? %>
            <span class="badge text-bg-secondary"><%= @smoker_profile.cigarette_type %></span>
          <% end %>
        </div>

        <p class="text-body-secondary lh-lg mb-3">
          <%= @smoker_profile.content %>
        </p>

        <% if @smoker_profile.years_to_live.present? %>
          <p class="mb-4">
            <strong>Estimated years to live :</strong>
            <span class="fw-bold text-primary"><%= @smoker_profile.years_to_live %></span>
          </p>
        <% end %>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
  <div class="d-flex flex-wrap gap-2">
    <button type="button"
        class="btn btn-light border border-secondary-subtle text-danger fw-semibold px-3 py-2 rounded-3"
        data-bs-toggle="modal"
        data-bs-target="#deleteShowProfileModal">
  Delete
</button>
    <% if (last_chat = current_user.chats.order(:created_at).last) %>
      <%= link_to "Chat", chat_path(last_chat), class: "btn btn-light border border-secondary-subtle text-dark fw-semibold px-3 py-2 rounded-3" %>
    <% end %>
  </div>

  <%= link_to "Back to home", root_path, class: "btn btn-light border border-secondary-subtle text-dark fw-semibold px-3 py-2 rounded-3" %>
</div>
</div>
      </div>
    </div>
  </div>
  <div class="modal fade" id="deleteShowProfileModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 rounded-4 shadow p-3">
      <p class="mb-3 fw-semibold">Delete this profile?</p>
      <div class="d-flex justify-content-end gap-2">
        <button type="button" class="btn btn-light border border-secondary-subtle rounded-3" data-bs-dismiss="modal">Cancel</button>
        <%= button_to "Delete",
                      smoker_profile_path(@smoker_profile),
                      method: :delete,
                      class: "btn btn-light border border-danger-subtle text-danger fw-semibold rounded-3" %>
      </div>
    </div>
  </div>
</div>
</div>
