<% fallback_image = @smoker_profile.cigarette_type == "e_cigarette" ? "ecigarette.jpg" : "marlboro-red.jpg" %>
<h2><%= @smoker_profile.name %></h2>
<div class="row">
  <div class="col-4">
    <%= image_tag(
          @smoker_profile.image.presence || fallback_image,
          class: "img-fluid rounded",
          alt: @smoker_profile.name.presence || "Smoker profile"
        ) %>
  </div>
  <div class="col-8">
    <h3><%= @smoker_profile.cigarette_type %></h3>
    <p><%= @smoker_profile.content %></p>
  </div>
</div>
</div>
