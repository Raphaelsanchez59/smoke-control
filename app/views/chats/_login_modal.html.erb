<div class="modal fade" id="loginModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Save your smoker profile</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        Create an account or log in to generate your profile and keep chatting with your coach.
        Your report will be kept.
      </div>
      <div class="modal-footer">
        <%= link_to "Log in", new_user_session_path, class: "btn btn-outline-primary" %>
        <%= link_to "Sign up", new_user_registration_path, class: "btn btn-primary" %>
      </div>
    </div>
  </div>
</div>
