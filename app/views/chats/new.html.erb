<div class="container-fluid py-4 px-lg-4">
  <div class="row g-4 align-items-start">
    <%# Colonne gauche (+ large) : Espace principal chatbot %>
    <section class="col-lg-9">
      <div class="card shadow-sm">
        <div class="card-header bg-white py-3">
          <h2 class="h4 mb-0">Evaluons ta consommation avec le chatbot</h2>
        </div>

        <div class="card-body p-4">
          <%= form_with model: @chat do |f| %>
            <div class="row g-3 align-items-end">
              <div class="col-lg-9">
                <%= f.label :title, "Sujet de la discussion", class: "form-label" %>
                <%= f.text_field :title, class: "form-control form-control-lg", placeholder: "Réponds ici ..." %>
              </div>

              <div class="col-lg-3">
                <%= f.submit "Lancer le chat", class: "btn btn-primary btn-lg w-100 text-nowrap" %>
              </div>
            </div>
          <% end %>

          <hr class="my-4">

          <%# Grande zone de discussion statique pour la mise en page %>
          <div class="border rounded p-3 bg-light d-flex flex-column gap-3" style="min-height: 320px; max-height: 450px; overflow-y: auto;">
            <div class="p-3 rounded bg-white border shadow-sm align-self-start" style="max-width: 80%;">
              <div class="fw-semibold small text-primary mb-1">Assistant</div>
              <div class="small">Bonjour ! Dis-moi comment tu consommes aujourd'hui pour qu'on fasse évoluer ton profil fumeur.</div>
            </div>

            <div class="p-3 rounded bg-primary text-white shadow-sm align-self-end" style="max-width: 80%;">
              <div class="fw-semibold small mb-1">Moi</div>
              <div class="small">Je tourne autour de 150 puffs par jour et j'aimerais commencer à réduire.</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <%# Colonne droite (- large) : Carte profil fumeur compacte %>
    <aside class="col-lg-3">
      <div class="mb-3">
        <h1 class="h5 mb-1">Smoker Profil</h1>
        <p class="text-muted small mb-0">Compare your life expectancy</p>
      </div>

      <div class="card shadow-sm">
        <div class="text-center p-2 bg-light border-bottom">
          <%= image_tag "ecigarette.jpg", alt: "Profil fumeur", class: "img-fluid rounded", style: "max-height: 145px; object-fit: contain;" %>
        </div>

        <div class="card-body p-3">
          <h2 class="h6 fw-bold mb-2">e-cigarette</h2>
          <p class="small text-secondary mb-3">
            At 35 years old, with a consumption of 150 puffs per day for the past 10 years,
            your life expectancy is 50 years. If you want to go further, cut down!
          </p>

          <div class="d-flex flex-wrap gap-1">
            <span class="badge text-bg-light border">35 ans</span>
            <span class="badge text-bg-light border">150 puffs/j</span>
            <span class="badge text-bg-light border">Espérance : 50 ans</span>
          </div>
        </div>
      </div>
    </aside>
  </div>
</div>
