<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-md-6">
      <h1 class="mb-4">Démarrer une conversation avec le chatbot</h1>

      <%= form_with model: @chat do |f| %>
        <div class="mb-3">
          <%= f.label :title, "Sujet de la discussion", class: "form-label" %>
          <%= f.text_field :title, class: "form-control", placeholder: "Réponds ici ..." %>
        </div>

        <%= f.submit "Lancer le chat", class: "btn btn-primary" %>
      <% end %>
    </div>
  </div>
</div>
