<template data-typing-target="template">
  <div class="d-flex justify-content-start mb-3">
    <div class="bubble bubble-bot">
      <% if chat.report_next? %>
        <div class="text-muted d-flex align-items-center gap-3">
          <div class="cigarette-loader" role="status">
            <span class="cig-ember">
              <span class="cig-smoke"></span>
              <span class="cig-smoke"></span>
            </span>
            <span class="cig-paper"></span>
            <span class="cig-filter"></span>
          </div>
          Smoking the whole pack while I build your profile…
        </div>
      <% else %>
        <div class="cigarette-loader" role="status">
          <span class="cig-ember">
            <span class="cig-smoke"></span>
            <span class="cig-smoke"></span>
          </span>
          <span class="cig-paper"></span>
          <span class="cig-filter"></span>
        </div>
      <% end %>
    </div>
  </div>
</template>
