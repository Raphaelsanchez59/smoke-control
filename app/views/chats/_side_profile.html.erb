<aside class="col-lg-3 text-center">
      <div class="mb-3">
        <h1 class="h5 mb-1">Smoker Profil</h1>
        <p class="text-muted small mb-0">Compare your life expectancy</p>
      </div>

      <div class="card shadow-sm">
        <div class="text-center p-2 bg-light border-bottom">
          <%= image_tag(
            case @smokerprofile.cigarette_type
              when "cigarette" then "cigarette.jpg"
              when "ecigarette" then "ecigarette.jpg"
              when "both" then "ecigarette-cigarette.jpg"
            end,
            alt: "Profil fumeur",
            class: "img-fluid rounded",
            style: "max-height: 145px; object-fit: contain;"
          ) %>
        </div>

        <div class="card-body p-3">
          <h2 class="h6 fw-bold mb-2">@smokerprofile.cigarette_type</h2>
          <p class="small text-secondary mb-3">
            content
          </p>

          <div class="d-flex flex-wrap gap-1">
            <span class="badge text-bg-light border"><%= (Date.today - @smokerprofile.birth_date).floor  %> years</span>
            <%= case @smokerprofile.cigarette_type %>
              <% when "cigarette" %>
                <span class="badge text-bg-light border">
                  <%= @smokerprofile.cigarettes.quantity_by_day %> cigarettes/day
                </span>"
              <% when "ecigarette" %>
                <span class="badge text-bg-light border">
                  <%= @smokerprofile.ecigarettes.puff_by_day %> puffs/day
                </span>
              <% when "both" %>
                <span class="badge text-bg-light border">
                  <%= @smokerprofile.cigarettes.quantity_by_day %> cigarettes/day
                </span>
                <span class="badge text-bg-light border">
                  <%= @smokerprofile.ecigarettes.puff_by_day %>
                </span>
            <% end %>
            <span class="badge text-bg-light border">Years to live :<%=@smokerprofile.years_to_live %></span>
          </div>
        </div>
      </div>
    </aside>
