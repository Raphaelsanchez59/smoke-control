<aside class="text-center">
      <div class="mb-3">
        <h1 class="h5 mb-1">Smoker Profil</h1>
        <p class="text-muted small mb-0">Compare your life expectancy</p>
      </div>

      <div class="card shadow-sm">

        <% if chat.profile_data["smoker_type"].present? %>
        <div class="text-center p-2 bg-light border-bottom">
          <%= image_tag(
            case chat.profile_data["smoker_type"]
              when "cigarette" then "cigarette.jpg"
              when "e_cigarette" then "ecigarette.jpg"
              when "both" then "ecigarette-cigarette.jpg"
              else "ecigarette-cigarette.jpg"

            end,
            alt: "Profil fumeur",
            class: "img-fluid rounded",
            style: "max-height: 145px; object-fit: contain;"
          ) %>
        </div>
        <% end %>

        <div class="card-body p-3">
          <h2 class="h6 fw-bold mb-2"><%= chat.profile_data["smoker_type"] %></h2>
          <% if chat.profile_data["content"].present? %>
          <p class="small text-secondary mb-3">
            <%= chat.profile_data["content"] %>
          </p>
          <% end %>

          <div class="d-flex flex-wrap gap-1">
            <% if chat.profile_data["birth_year"].present? %>
            <span class="badge text-bg-light border"><%= Date.today.year - chat.profile_data["birth_year"]  %> years</span>
            <% end %>
            <% if chat.profile_data["smoker_type"] == "cigarette" %>
              <% if chat.profile_data["cigarettes_per_day"].present? %>
                <span class="badge text-bg-light border">
                  <%= chat.profile_data["cigarettes_per_day"] %> cigarettes/day
                </span>
              <% end %>
            <% elsif chat.profile_data["smoker_type"] == "e_cigarette" %>
              <% if chat.profile_data["puffs_per_day"].present? %>
                <span class="badge text-bg-light border">
                  <%= chat.profile_data["puffs_per_day"] %> puffs/day
                </span>
              <% end %>
            <% elsif chat.profile_data["smoker_type"] == "both" %>
              <% if chat.profile_data["cigarettes_per_day"].present? %>
                <span class="badge text-bg-light border">
                  <%= chat.profile_data["cigarettes_per_day"] %> cigarettes/day
                </span>
              <% end %>
              <% if chat.profile_data["puffs_per_day"].present? %>
                <span class="badge text-bg-light border">
                  <%= chat.profile_data["puffs_per_day"] %> puffs/day
                </span>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    </aside>
