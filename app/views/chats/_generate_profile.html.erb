<div>
  <% if user_signed_in? %>
    <%= button_to "Generate your smoker profile", generate_profile_chat_path(chat),
          class: "btn btn-success px-4" %>
  <% else %>
    <button type="button" class="btn btn-success px-4"
            data-bs-toggle="modal" data-bs-target="#loginModal">
      Generate your smoker profile
    </button>
  <% end %>
</div>
