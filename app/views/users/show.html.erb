<h1>Profile of <%= @user.nickname.presence || @user.email %></h1>
<dl>
  <dt>Nickname</dt>
  <dd><%= @user.nickname.presence || "Not provided" %></dd>
  <dt>Email</dt>
  <dd><%= @user.email %></dd>
  <dt>Birth date</dt>
  <dd><%= @user.birth_date ? @user.birth_date.strftime("%B %d, %Y") : "Not provided" %></dd>
  <dt>Start smoking year</dt>
  <dd><%= @user.start_smoking_year.presence || "Not provided" %></dd>
</dl>
<%= link_to "Edit profile", edit_user_registration_path %>